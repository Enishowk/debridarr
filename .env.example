# Your API key for Alldebrid
ALL_DEBRID_API_KEY=your_api_key_here

# The root path where the files will be downloaded
ROOT_PATH=/mnt/nas/downloads
MOVIES_PATH=/movies
SERIES_PATH=/series

# Login credentials, the app is open to anyone who can reach it if not set
AUTH_USERNAME=admin
AUTH_PASSWORD=change_me

# User
PUID=1000
PGID=1000

# Behind a reverse proxy: "true", number of hops or proxy IPs/subnets (optional)
# TRUST_PROXY=loopback

# Server port (for dev)
PORT=5173
